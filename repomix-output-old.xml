                for layer_spec_idx in self.probe_layers_to_extract:
                     extracted_embeddings_dict[f"layer_{layer_spec_idx}"] = None
            else:
                target_idx_in_gen_hs = min(effective_n_generated - 1, num_tokens_in_hs_output - 1)

