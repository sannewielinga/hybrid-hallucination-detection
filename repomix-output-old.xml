        logging.info(f"Calculated OOF {hybrid_simple_col} for {len(df_hybrid_simple_oof)} samples.")

    else:
         logging.warning("Not enough data or classes to perform K-Fold CV for Hybrid (Simple Avg). Skipping.")


    plot_dir = None
    if save_plots:
