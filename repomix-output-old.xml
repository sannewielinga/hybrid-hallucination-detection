    results = {}
    methods_to_calc = {
        'SE': 'semantic_entropy',
        'NSE': 'normalized_semantic_entropy',
        'Naive': 'naive_entropy',
        'IS Probe': 'internal_signal_score',
        'Hybrid (Simple Avg)': hybrid_simple_col,
