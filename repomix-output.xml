def save_plot(figure, filepath):
    """
    Saves the provided matplotlib figure to the specified file path and logs the result.
    
    Parameters:
        figure (matplotlib.figure.Figure): The figure to be saved.
        filepath (str or Path): The location where the figure will be saved.
    
    Logs:
        Success message if the figure is saved successfully.
        Error message if an exception occurs during saving.
    
    Closes the figure to release resources after attempting to save.
    """

    try:
        figure.savefig(filepath, bbox_inches="tight", dpi=150)
        logging.info(f"Plot saved to: {filepath}")
    except Exception as e:
        logging.error(f"Failed to save plot {filepath}: {e}")
    plt.close(figure)


